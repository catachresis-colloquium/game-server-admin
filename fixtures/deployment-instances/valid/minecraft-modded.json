{
  "contract": {
    "name": "gsa.deployment-instance",
    "version": "0.1.0"
  },
  "id": "minecraft-modded",
  "profile_id": "minecraft-java",
  "host": "fixture-host",
  "runtime": {
    "type": "systemd",
    "identity": "gsa-fixture-minecraft-modded.service"
  },
  "ports": [
    {
      "protocol": "tcp",
      "port": 25567,
      "purpose": "game"
    }
  ],
  "paths": {
    "data": [
      "/srv/gsa-fixtures/minecraft-modded"
    ],
    "config": [
      "/srv/gsa-fixtures/minecraft-modded/server.properties"
    ],
    "world": [
      "/srv/gsa-fixtures/minecraft-modded/world"
    ]
  },
  "game": {
    "version": "1.21.11",
    "update_channel": "fabric/snapshots/custom-track",
    "mods": [
      {
        "id": "fabric-loader",
        "version": "0.18.1"
      }
    ]
  },
  "resources": {
    "memory": {
      "minimum": "1G",
      "maximum": "2G"
    }
  },
  "backup": {
    "policy_ref": "minecraft-world-backup"
  },
  "capabilities": {
    "probe": {
      "enabled": true,
      "mode": "read-only"
    },
    "config": {
      "enabled": true,
      "mode": "read-only"
    },
    "logs": {
      "enabled": true,
      "mode": "read-only"
    },
    "lifecycle": {
      "start": false,
      "stop": false,
      "restart": false,
      "update": false
    },
    "backup": {
      "enabled": false
    }
  }
}
